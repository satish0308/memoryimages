# ==============================================================================
# MyMemoryPics Environment Configuration Template
# Copy this file to .env and configure values before starting Docker containers.
# ==============================================================================

# ------------------------------------------------------------------------------
# Service Ports (Host Mapping)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5433
REDIS_PORT=6379
MINIO_PORT=9004
MINIO_CONSOLE_PORT=9005

# ------------------------------------------------------------------------------
# Backend & Application Security
# ------------------------------------------------------------------------------
SECRET_KEY=your_secret_key_here
MEDIA_DIR=/data/originals
THUMBNAIL_DIR=/data/thumbnails
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Frontend Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Database Settings (Dual-Engine: SQLite or PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:////data/db/memorypics.db

# PostgreSQL / pgvector settings
POSTGRES_USER=your_postgres_username
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_postgres_db_name
POSTGRES_URL=postgresql://your_postgres_username:your_postgres_password@db:5432/your_postgres_db_name

# ------------------------------------------------------------------------------
# Redis & Task Queue
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# S3 / MinIO Object Storage Configuration
# ------------------------------------------------------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=your_minio_access_key
S3_SECRET_ACCESS_KEY=your_minio_secret_key
S3_BUCKET_NAME=your_s3_bucket_name
S3_REGION_NAME=us-east-1
S3_PUBLIC_URL=http://localhost:9004
S3_CONSOLE_URL=http://localhost:9005

# ------------------------------------------------------------------------------
# Google Drive / Photos Integration (Optional - configure to enable Google sync)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/sync/google/callback
