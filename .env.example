# MyMemoryPics Environment Configuration

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Backend Settings
SECRET_KEY=change_this_to_a_random_secure_string_in_production
DATABASE_URL=sqlite:////data/db/memorypics.db
MEDIA_DIR=/data/originals
THUMBNAIL_DIR=/data/thumbnails
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Drive / Photos Integration (Optional - configure to enable Google sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/sync/google/callback

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000

# S3 / MinIO Object Storage (Optional)
S3_ENDPOINT_URL=http://localhost:9002
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change_this_to_a_secure_s3_secret
S3_BUCKET_NAME=mymemorypics
S3_REGION_NAME=us-east-1
S3_PUBLIC_URL=http://localhost:9002
S3_CONSOLE_URL=http://localhost:9001

# Database Settings
POSTGRES_USER=memorypics
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=memorypics
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6379
